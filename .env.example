# =============================================================================
# .env — AI Support Agent Configuration
# =============================================================================
# Copy this file to .env and fill in GOOGLE_API_KEY.
# Then run:   docker-compose up --build
#
# API docs: http://localhost:8088/docs
# =============================================================================


# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here


# ── LLM / Embedding ───────────────────────────────────────────────────────────
MODEL_NAME=gemini-3.1-flash-lite
EMBEDDING_MODEL=models/text-embedding-004


# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_PORT=8088
LOG_LEVEL=INFO


# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
MAX_RETRIEVED_EXAMPLES=3


# ── SQLite (audit log — no setup needed, file created automatically) ──────────
SQLITE_DB_PATH=./data/support_agent.db


# ── Evaluation ────────────────────────────────────────────────────────────────
GOLDEN_SET_SIZE=200
GOLDEN_SET_PATH=./data/golden_set/golden_set.jsonl


# ── Optional: Kaggle (only needed to re-download raw Twitter dataset) ─────────
KAGGLE_TOKEN=