# ── Secrets ──────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
KAGGLE_TOKEN=your_kaggle_token_here

# ── Model config ─────────────────────────────────────────
MODEL_NAME=gemini-2.0-flash-lite
EMBEDDING_MODEL=models/text-embedding-004

# ── FastAPI server ────────────────────────────────────────
FASTAPI_PORT=8088
LOG_LEVEL=INFO

# ── ChromaDB ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
MAX_RETRIEVED_EXAMPLES=3

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=support_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agentpass

# ── Evaluation ────────────────────────────────────────────
GOLDEN_SET_SIZE=200
GOLDEN_SET_PATH=./data/golden_set/golden_set.jsonl